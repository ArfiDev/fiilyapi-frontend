    "@testing-library/user-event": "^14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3",
    "eslint": "^9",
    "eslint-config-next": "^15.1",
    "jsdom": "^25",
    "openapi-typescript": "^7.4",
